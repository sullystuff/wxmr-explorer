# Private, server-side Helius endpoint. Never commit your real .env.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
# Optional WebSocket override; defaults to SOLANA_RPC_URL with https -> wss.
# SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
# HTTP fallback interval when the WebSocket is unavailable (also used by sync).
POLL_INTERVAL_MS=15000
RPC_INTERVAL_MS=300
DATA_DIR=./data
HOST=127.0.0.1
PORT=3100
